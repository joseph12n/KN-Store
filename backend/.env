# Variables de entorno para la configuracion del backend
MONGO_URI=mongodb://localhost:27017/kn_store
JWT_SECRET=asdola
PORT=3000

# ==================== CORREO ELECTRÓNICO (Nodemailer) ====================
# INSTRUCCIONES PARA NICOLÁS:
# Completa UNA de las dos opciones y comparte estas variables con el equipo.
# Los demás miembros deben copiar estas variables a su propio .env local.

# ------------------------------------------------------------------
# Opción A — Mailtrap (RECOMENDADA para pruebas — NO envía correos reales)
# 1. Ir a https://mailtrap.io → registrarse gratis
# 2. Inboxes → My Inbox → SMTP Settings → copiar usuario y contraseña
# ------------------------------------------------------------------
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=tu_mailtrap_user
EMAIL_PASS=tu_mailtrap_pass
EMAIL_FROM=KN-Store <no-reply@knstore.com>

# ------------------------------------------------------------------
# Opción B — Gmail (descomentar y comentar opción A)
# Requiere: Gmail con 2FA activado + App Password de 16 caracteres
# Generar en: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------
# EMAIL_SERVICE=gmail
# EMAIL_USER=tu_correo@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM=KN-Store <tu_correo@gmail.com>

# URL del frontend (usada en los links de los correos)
FRONTEND_URL=http://localhost:5173