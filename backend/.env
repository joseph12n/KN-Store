# Variables de entorno para la configuracion del backend
MONGO_URI=mongodb://localhost:27017/kn_store
JWT_SECRET=asdola
PORT=3000

# ==================== CORREO ELECTRÓNICO (Nodemailer) ====================
# Opción A — Mailtrap (pruebas, NO envía correos reales)
# Crear cuenta gratis en https://mailtrap.io → Inboxes → SMTP Settings
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=tu_mailtrap_user
EMAIL_PASS=tu_mailtrap_pass
EMAIL_FROM=KN-Store <no-reply@knstore.com>

# Opción B — Gmail (descomentar y comentar opción A si usas Gmail)
# Requiere: activar 2FA en Gmail + generar un App Password en tu cuenta
# EMAIL_SERVICE=gmail
# EMAIL_USER=tu_correo@gmail.com
# EMAIL_PASS=tu_app_password_de_16_caracteres
# EMAIL_FROM=KN-Store <tu_correo@gmail.com>

# URL del frontend (para los enlaces de los correos)
FRONTEND_URL=http://localhost:5173