{
  "info": {
    "name": "KN-Store - Users Module",
    "description": "Colección de Postman para probar el módulo de Usuarios (Autenticación, Autorización por roles y CRUD).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public (Auth & Registration)",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Juan Cliente\",\n    \"email\": \"cliente@gmail.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "register" ]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('token', data.token);",
                  "    pm.environment.set('role', data.role);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"cliente@gmail.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "login" ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Client Actions",
      "item": [
        {
          "name": "Get Own Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "profile" ]
            }
          }
        },
        {
          "name": "Delete Own Profile",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "profile" ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin & Provider Actions",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users" ]
            }
          }
        },
        {
          "name": "Create Provider (Or Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Pedro Proveedor\",\n    \"email\": \"proveedor@gmail.com\",\n    \"password\": \"123456\",\n    \"role\": \"Provider\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users" ]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Juan Cliente Editado\",\n    \"role\": \"Client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "{{userId}}" ]
            }
          }
        },
        {
          "name": "Delete Specific User (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "users", "{{userId}}" ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": "ID_DEL_USUARIO_AQUI"
    }
  ]
}
